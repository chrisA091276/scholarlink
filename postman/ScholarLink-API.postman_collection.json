{
  "info": {
    "name": "ScholarLink API",
    "description": "ScholarLink /api/v1. Fictional examples only. Register a student or log in, then complete the profile, save a draft, upload configured documents and submit with declaration=true. Auth requests save tokens to both collection and selected environment variables. Use staff/admin credentials only for their authorized workflows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Student\",\n  \"email\": \"fictional.student@example.test\",\n  \"password\": \"Password123\",\n  \"password_confirmation\": \"Password123\",\n  \"terms_accepted\": true,\n  \"device_name\": \"postman\",\n  \"contact_number\": \"09171234567\"\n}"
            },
            "url": "{{base}}/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.token) { pm.collectionVariables.set('token', body.token); pm.environment.set('token', body.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@adfc.edu.ph\",\n  \"password\": \"Student123!\",\n  \"login_role\": \"student\",\n  \"device_name\": \"postman\"\n}"
            },
            "url": "{{base}}/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.token) { pm.collectionVariables.set('token', body.token); pm.environment.set('token', body.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
